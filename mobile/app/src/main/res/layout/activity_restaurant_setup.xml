<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="48dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/prompt_bold"
            android:letterSpacing="-0.02"
            android:text="Restaurant Setup"
            android:textColor="#0F172A"
            android:textSize="28sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/ubuntu"
            android:text="Let's get your store details configured."
            android:textColor="#64748B"
            android:textSize="16sp" />

        <!-- Logo picker -->
        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="28dp">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/ivRestaurantLogo"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@drawable/ic_store"
                android:scaleType="centerCrop"
                app:civ_border_color="#E2E8F0"
                app:civ_border_width="2dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnPickLogo"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="bottom|end"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#6366F1"
                app:cardCornerRadius="15dp"
                app:cardElevation="3dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="#FFFFFF" />
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/ubuntu"
            android:text="Tap to add logo (optional)"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Restaurant Name" android:fontFamily="@font/ubuntu_bold" android:textColor="#334155" android:textSize="14sp" />
                <EditText
                    android:id="@+id/etRestaurantName"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_edittext_modern"
                    android:hint="e.g. My Cafe"

                    android:inputType="textCapWords"
                    android:paddingHorizontal="16dp"
                    android:textColor="#0F172A" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Physical Location" android:fontFamily="@font/ubuntu_bold" android:textColor="#334155" android:textSize="14sp" />
                <EditText
                    android:id="@+id/etLocation"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_edittext_modern"
                    android:hint="Address or City"
                    android:inputType="textPostalAddress"
                    android:paddingHorizontal="16dp"
                    android:textColor="#0F172A" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Opens" android:fontFamily="@font/ubuntu_bold" android:textColor="#334155" android:textSize="14sp" />
                        <EditText
                            android:id="@+id/etOpeningTime"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_edittext_modern"
                            android:focusable="false"
                            android:hint="08:00"
                            android:paddingHorizontal="16dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Closes" android:fontFamily="@font/ubuntu_bold" android:textColor="#334155" android:textSize="14sp" />
                        <EditText
                            android:id="@+id/etClosingTime"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_edittext_modern"
                            android:focusable="false"
                            android:hint="22:00"
                            android:paddingHorizontal="16dp" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCompleteSetup"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="32dp"
                    android:fontFamily="@font/ubuntu_bold"
                    android:text="Complete Setup"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    app:backgroundTint="#6366F1"
                    app:cornerRadius="16dp"
                    app:elevation="0dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>