<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#F4F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="120dp"
        android:paddingEnd="32dp"
        android:paddingBottom="32dp">

        <ImageView
            android:id="@+id/imgPendingIcon"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:contentDescription="Pending approval"
            android:src="@drawable/ic_pending_clock" />

        <TextView
            android:id="@+id/tvPendingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:fontFamily="@font/prompt_bold"
            android:gravity="center"
            android:text="Account Pending\nApproval"
            android:textAlignment="center"
            android:textColor="#111243"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPendingMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/ubuntu"
            android:gravity="center"
            android:text="Hi [User Name], thanks for signing up for the RevnU portal for ChiNyMic Restobar."
            android:textColor="#1A1D4F"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Check back later"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:backgroundTint="#8E8BFF"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_arrow_back"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@android:color/white"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />
    </LinearLayout>
</ScrollView>