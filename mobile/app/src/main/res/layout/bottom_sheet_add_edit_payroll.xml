<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_sheet"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <View
            android:layout_width="48dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_drag_handle" />

        <TextView
            android:id="@+id/tvPayFormTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:fontFamily="@font/prompt_bold"
            android:letterSpacing="-0.01"
            android:text="Record Salary"
            android:textColor="#0F172A"
            android:textSize="22sp" />

        <!-- Employee label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/ubuntu_bold"
            android:letterSpacing="0.06"
            android:text="EMPLOYEE"
            android:textColor="#9CA3AF"
            android:textSize="11sp" />

        <Spinner
            android:id="@+id/spinnerEmployee"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_spinner_outlined"
            android:paddingHorizontal="14dp" />

        <!-- Amount -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPayAmount"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="14dp"
            android:hint="Amount (₱)"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxStrokeColor="#E2E8F0"

            app:hintTextColor="#9CA3AF">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPayAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ubuntu"
                android:inputType="numberDecimal"
                android:textColor="#0F172A"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Payment Date -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPayDate"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="28dp"
            android:hint="Payment Date"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_calendar"
            app:endIconTint="#6366F1"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxStrokeColor="#E2E8F0"

            app:hintTextColor="#9CA3AF">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPayDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ubuntu"
                android:inputType="none"
                android:focusable="false"
                android:textColor="#0F172A"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Save -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPayFormSave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/ubuntu_bold"
            android:text="Record Salary"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            app:backgroundTint="#6366F1"
            app:cornerRadius="16dp"
            app:elevation="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPayFormClose"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="20dp"
            android:fontFamily="@font/ubuntu_bold"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#64748B"
            android:textSize="15sp"
            app:cornerRadius="16dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1.5dp" />
    </LinearLayout>
</ScrollView>
