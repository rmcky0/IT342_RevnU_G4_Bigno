<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="48dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_auth_tab_active"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="#0F172A" />

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_revnu_logo" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/prompt_bold"
            android:letterSpacing="-0.02"
            android:text="Forgot Password"
            android:textColor="#0F172A"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/ubuntu"
            android:gravity="center"
            android:text="Enter your email to receive a secure verification code."
            android:textColor="#64748B"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_error_banner"
            android:fontFamily="@font/ubuntu"
            android:padding="12dp"
            android:textColor="#B91C1C"
            android:textSize="13sp"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <LinearLayout
                    android:id="@+id/stepEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Email Address" android:fontFamily="@font/ubuntu_bold" android:textColor="#334155" android:textSize="14sp" />
                    <EditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:background="@drawable/bg_edittext_modern" android:hint="your@email.com" android:inputType="textEmailAddress" android:paddingHorizontal="16dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnSendOtp" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="24dp" android:text="Send OTP" android:textAllCaps="false" app:cornerRadius="16dp" app:backgroundTint="#6366F1" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/stepOtp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Enter 6-digit Code" android:fontFamily="@font/ubuntu_bold" android:textColor="#334155" android:textSize="14sp" />
                    <EditText android:id="@+id/etOtp" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:background="@drawable/bg_edittext_outline" android:gravity="center" android:hint="000000" android:inputType="number" android:letterSpacing="0.5" android:maxLength="6" android:textSize="22sp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnVerifyOtp" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="24dp" android:text="Verify Code" android:textAllCaps="false" app:cornerRadius="16dp" app:backgroundTint="#6366F1" />
                    <TextView android:id="@+id/tvResendOtp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginTop="16dp" android:text="Resend Code" android:textColor="#6366F1" android:fontFamily="@font/ubuntu_bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/stepNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="New Password" android:fontFamily="@font/ubuntu_bold" android:textColor="#334155" android:textSize="14sp" />
                    <EditText android:id="@+id/etNewPassword" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:background="@drawable/bg_edittext_outline" android:inputType="textPassword" android:paddingHorizontal="16dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Confirm Password" android:fontFamily="@font/ubuntu_bold" android:textColor="#334155" android:textSize="14sp" />
                    <EditText android:id="@+id/etConfirmPassword" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:background="@drawable/bg_edittext_outline" android:inputType="textPassword" android:paddingHorizontal="16dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnResetPassword" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="24dp" android:text="Reset Password" android:textAllCaps="false" app:cornerRadius="16dp" app:backgroundTint="#6366F1" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/stepDone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@android:drawable/checkbox_on_background" app:tint="#10B981" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Password Reset!" android:fontFamily="@font/prompt_bold" android:textSize="20sp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnBackToLogin" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="24dp" android:text="Log In" android:textAllCaps="false" app:cornerRadius="16dp" app:backgroundTint="#6366F1" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>