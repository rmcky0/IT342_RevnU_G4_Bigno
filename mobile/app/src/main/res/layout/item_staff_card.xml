<?xml version="1.0" encoding="utf-8"?>
<!-- item_staff_card.xml — matches web Directory row: avatar · name · position badge · salary rate -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#EDEEF5"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <!-- Avatar circle -->
        <TextView
            android:id="@+id/tvStaffAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#818CF8"
            android:background="@drawable/bg_avatar_indigo"
            android:text="A" />

        <!-- Name + Position -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvEmpName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Employee Name"
                android:textColor="#111243"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Position badge -->
            <TextView
                android:id="@+id/tvEmpPosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_badge_gray"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="Position"
                android:textColor="#6B7280"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Salary rate -->
        <TextView
            android:id="@+id/tvEmpRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₱0.00"
            android:textColor="#111243"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Chevron -->
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="#D1D5DB" />

    </LinearLayout>
</androidx.cardview.widget.CardView>