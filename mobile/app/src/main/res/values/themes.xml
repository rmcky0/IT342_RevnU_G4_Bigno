<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Mobile" parent="Theme.MaterialComponents.DayNight.NoActionBar"/>

    <style name="KeypadButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">80dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="KeypadButtonModern" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">28sp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="KeypadActionModern" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="tint">#9CA3AF</item>
    </style>

    <style name="KeypadActionModernText" parent="KeypadButtonModern">
        <item name="android:textColor">#9CA3AF</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="ModernNumberPicker" parent="Theme.AppCompat.Light">
        <item name="android:textSize">18sp</item>
        <item name="android:textColorPrimary">#0F172A</item>
        <item name="colorControlNormal">#8B5CF6</item> </style>
</resources>