# ── Database (Supabase direct connection) ────────────────────────────────────
DB_URL=jdbc:postgresql://<supabase-host>:5432/postgres?user=<user>&password=<password>
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=your_db_password

# ── Supabase Storage ─────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# ── JWT Security ─────────────────────────────────────────────────────────────
JWT_SECRET=your_very_long_random_secret_at_least_32_characters
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ── Google OAuth2 ─────────────────────────────────────────────────────────────
# Get these from https://console.cloud.google.com → APIs & Services → Credentials
# Authorised redirect URI must include:
#   http://localhost:8080/login/oauth2/code/google        (dev)
#   https://your-render-app.onrender.com/login/oauth2/code/google  (prod)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# ── Email ─────────────────────────────────────────────────────────────────────
# Dev (Gmail SMTP) — generate an App Password at https://myaccount.google.com/apppasswords
SPRING_PROFILES_ACTIVE=dev
GMAIL_USERNAME=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
MAIL_FROM=RevnU Team <your_gmail_address@gmail.com>

# Prod (Resend) — set SPRING_PROFILES_ACTIVE=prod
# RESEND_API_KEY=your_resend_api_key
# MAIL_FROM=RevnU Team <onboarding@resend.dev>

# ── Admin Seed Account ────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASS=StrongAdminPassword!

# ── External APIs ─────────────────────────────────────────────────────────────
HOLIDAY_API_KEY=your_calendarific_api_key

# ── App URLs ──────────────────────────────────────────────────────────────────
# Dev:  http://localhost:5173
# Prod: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173
